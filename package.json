    "build": "node scripts/generate-public-meta.js && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css}\" \"docs/**/*.md\" \"scripts/**/*.js\" package.json vite.config.js eslint.config.js jest.config.js babel.config.cjs index.html README.md .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css}\" \"docs/**/*.md\" \"scripts/**/*.js\" package.json vite.config.js eslint.config.js jest.config.js babel.config.cjs index.html README.md .prettierrc.json",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.107.1",
    "@vitejs/plugin-react": "^5.0.0",
    "axios": "^1.21.0",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.91.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0",
    "zod": "^4.6.7"
